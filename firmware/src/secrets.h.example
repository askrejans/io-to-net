//
//    cp firmware/src/secrets.h.example firmware/src/secrets.h
// ─────────────────────────────────────────────────────────────────

// ── WiFi credentials ─────────────────────────────────────────────
#define WIFI_SSID       "YourNetworkName"
#define WIFI_PASSWORD   "YourNetworkPassword"

// ── Authentication ────────────────────────────────────────────────
// Clients must send this token as the first line after connecting.
// Set to "" to disable authentication entirely.
#define AUTH_TOKEN      ""
